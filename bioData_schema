const mongoose = require('mongoose');

const AddressSchema = new mongoose.Schema({
  address: { 
    type: String, 
    required: true 
  },
  district: { 
    type: String, 
    required: true 
  },
  pin: { 
    type: Number, 
    required: true 
  },
  phone: { 
    type: Number, 
    required: true 
  }
});

const AttemptSchema = new mongoose.Schema({
  I: { 
    type: Number, 
    required: true 
  },
  II: { 
    type: Number, 
    required: true 
  },
  III: { 
    type: Number, 
    required: true 
  }
});

const MarksSchema = new mongoose.Schema({
  maths: { 
    type: Number, 
    required: true 
  },
  physics: { 
    type: Number, 
    required: true 
  },
  chemistry: { 
    type: Number, 
    required: true 
  }
});

const EducationSchema = new mongoose.Schema({
  level: { 
    type: String, 
    required: true 
  },
  period_of_study: { 
    type: Number, 
    required: true 
  },
  college: { 
    type: String, 
    required: true 
  },
  university: { 
    type: String, 
    required: true 
  },
  attempts: AttemptSchema,
  marks: MarksSchema
});

const SemesterSchema = new mongoose.Schema({
  semester: { 
    type: Number, 
    required: true 
  },
  course: [
    {
      course_code: { 
        type: Number, 
        required: true 
      },
      course_title: { 
        type: String, 
        required: true 
      },
      credits: { 
        type: Number, 
        required: true 
      },
      no_of_attempts: [
        {
          mark: { 
            type: Number, 
            required: true 
          },
          grade: { 
            type: String, 
            required: true 
          },
          pass_fail: { 
            type: String, 
            required: true 
          }
        }
      ],
      grade_point: { 
        type: Number, 
        required: true 
      },
      attendance_grade: { 
        type: String, 
        required: true 
      },
      remarks: { 
        type: String 
      }
    }
  ],
  exam_month_year: { 
    type: String 
  },
  grade_sheet_serial: { 
    type: String 
  },
  remarks: { 
    type: String 
  },
  hosteller_or_day_scholar: { 
    type: String, 
    enum: ['Hosteller', 'Day Scholar'], 
    required: true 
  },
  faculty_advisor: { 
    type: String, 
    required: true 
  }
});

const AcademicSemesterSummary = new mongoose.Schema({
  semester: { 
    type: String, 
    required: true // Field is required
  },
  credits_registered: { 
    type: Number, 
    required: true 
  },
  credits_earned: { 
    type: Number, 
    required: true 
  },
  gpa: { 
    type: Number, 
    required: true 
  },
  rank: { 
    type: Number, 
    required: true 
  },
  month_year_of_passing: { 
    type: String, 
    required: true 
  }
});

const CareerDetailSchema = new mongoose.Schema({
  company: { 
    type: String, 
    required: true 
  },
  date_of_recruitment: { 
    type: String, 
    required: true 
  },
  position_offered: { 
    type: String, 
    required: true 
  },
  salary_package: { 
    type: Number, 
    required: true 
  },
  remarks: { 
    type: String 
  }
});


const bioData = new mongoose.Schema({
  student_roll_no: { 
    type: Number, 
    required: true 
  },
  name: {
    first_name: { 
      type: String, 
      required: true 
    },
    initial: { 
      type: String 
    }
  },
  photo: { 
    type: String 
  }, 
  signature: { 
    type: String 
  },
  gender: { 
    type: String, 
    enum: ['Male', 'Female', 'Other'], 
    required: true 
  },
  aadhar_no: { 
    type: Number, 
    required: true 
  },

  admission: {
    course: { 
      type: String, 
      required: true 
    },
    branch: { 
      type: String, 
      required: true 
    },
    date_of_admission: { 
      type: Date, 
      required: true 
    },
    period_of_study: { 
      type: Number 
    }
  },

  date_of_birth: { 
    type: Date, 
    required: true 
  },
  religion: { 
    type: String 
  },
  community: { 
    type: String 
  },

  contact: {
    mobile_no: { 
      type: Number, 
      required: true 
    },
    email: { 
      type: String, 
      required: true, 
      match: /.+\@.+\..+/
    },
    permanent_address: AddressSchema
  },

  parents: {
    parent_name: { 
      type: String, 
      required: true 
    },
    occupation: { 
      type: String 
    },
    annual_income: { 
      type: Number 
    },
    mobile_no: { 
      type: Number 
    },
    email: { 
      type: String, 
      match: /.+\@.+\..+/ 
    }
  },

  education_background: [EducationSchema],

  semesters: [SemesterSchema],

  extra_curricular_activities: [
    {
      semester: { 
        type: Number, 
        required: true 
      },
      activity: { 
        type: String, 
        required: true 
      }
    }
  ],

  academic_summary: {
    semesters: [AcademicSemesterSummary],
    total_credits: { 
      type: Number 
    },
    cgpa: { 
      type: Number 
    },
    class_obtained: { 
      type: String 
    },
    overall_rank: { 
      type: Number 
    },
    conduct_certificate_no_date: { 
      type: String 
    },
    tc_no_date: { 
      type: String 
    },
    consolidated_grade_sheet_no_date: { 
      type: String 
    },
    provisional_certificate_no_date: { 
      type: String 
    },
    degree_certificate_no_date: { 
      type: String 
    }
  },

  career_details: {
    at_leaving: [CareerDetailSchema]
  }
});

module.exports = mongoose.model('BioData', bioData);
